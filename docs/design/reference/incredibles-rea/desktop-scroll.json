{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files/Google/Chrome/Application/chrome.exe"
  },
  "start_url": {
    "url": "https://incredibles.dev/"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "reduced_motion": "no-preference",
    "timezone": "Asia/Calcutta"
  },
  "actions": [
    {
      "step_id": "scroll-0",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": "body"
      },
      "key": "PageDown",
      "timeout_ms": 5000
    },
    {
      "step_id": "settled-0",
      "action": "wait_for_timeout",
      "duration_ms": 900
    },
