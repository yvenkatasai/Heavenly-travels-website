{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files/Google/Chrome/Application/chrome.exe"
  },
  "start_url": {
    "url": "https://incredibles.dev/"
  },
  "environment": {
    "viewport": {
      "width": 390,
      "height": 844
    },
    "reduced_motion": "no-preference",
    "timezone": "Asia/Calcutta"
  },
  "actions": [
    {
      "step_id": "ready",
      "action": "wait_for_timeout",
      "duration_ms": 2500
    },
    {
      "step_id": "contact-open",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": ".s__menu-link--cta"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "drawer-ready",
      "action": "wait_for_timeout",
      "duration_ms": 1200
    }
  ],
  "capture": {
    "at_end": [
      "dom",
      "screenshot",
      "accessibility",
      "url"
    ],
    "events": [
      "page-errors"
    ]
  }
}