{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"
  },
  "start_url": {
    "url": "https://incredibles.dev/"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "reduced_motion": "no-preference",
    "timezone": "Asia/Calcutta"
  },
  "actions": [
    {
      "step_id": "settled",
      "action": "wait_for_timeout",
      "duration_ms": 6500
    }
  ],
  "capture": {
    "at_end": [
      "dom",
      "accessibility",
      "screenshot",
      "url"
    ],
    "events": [
      "console",
      "page-errors",
      "network"
    ],
    "network": {
      "response_body": true
    },
    "limits": {
      "max_network_body_bytes": 2097152,
      "max_network_body_allocation_bytes": 8388608,
      "max_total_event_allocation_bytes": 67108864
    }
  }
}