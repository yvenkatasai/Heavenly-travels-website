{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"
  },
  "start_url": {
    "url": "http://127.0.0.1:4188/#packages"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "timezone": "Asia/Calcutta",
    "reduced_motion": "reduce"
  },
  "actions": [
    {
      "step_id": "packages-visible",
      "action": "wait_for_timeout",
      "duration_ms": 1200
    }
  ],
  "capture": {
    "at_end": [
      "screenshot",
      "dom",
      "accessibility"
    ],
    "events": [
      "page-errors"
    ]
  }
}