{
  "name": "heavenly-travel-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build_site.mjs",
    "build:booking": "node scripts/build-booking.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write \"src/booking/**/*.{ts,tsx,css}\" \"src/components/**/*.{ts,tsx,css}\" \"src/lib/**/*.{ts,tsx,css}\" \"src/site/**/*.{js,css,html}\" \"scripts/**/*.{js,mjs,ts,tsx}\"",
    "format:check": "prettier --check \"src/booking/**/*.{ts,tsx,css}\" \"src/components/**/*.{ts,tsx,css}\" \"src/lib/**/*.{ts,tsx,css}\" \"src/site/**/*.{js,css,html}\" \"scripts/**/*.{js,mjs,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "verify:production": "node scripts/check-production.mjs",
    "verify:content": "node scripts/check-content.mjs",
    "test:whatsapp": "node --test tests/whatsapp-message.test.mjs",
    "test:indexnow": "node --test tests/indexnow.test.mjs",
    "indexnow:check": "node scripts/indexnow.mjs",
    "indexnow:submit": "node scripts/indexnow.mjs --submit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.161.0"
  }
}
